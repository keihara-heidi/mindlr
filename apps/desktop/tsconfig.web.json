{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/renderer/shared/*"],
      "@settings/*": ["./src/renderer/settings/*"],
      "@notch/*": ["./src/renderer/notch/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/preload/api.d.ts"]
}
